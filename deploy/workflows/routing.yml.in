# Generated by Relay workflow projection; edit deploy/workflows/routing.yml.in.
# Workflow contract: @@WORKFLOW_CONTRACT@@; consumer review/merge remains required.
name: Relay routing
run-name: >-
  ${{ github.event_name == 'workflow_dispatch' &&
      format('{0} · Task {1}{2}{3}', inputs.route == 'manual' && 'Manual handoff' || inputs.pull_request != '' && 'Auto remediation' || 'Auto implementation', inputs.task, inputs.step != '' && format(' · Step {0}', inputs.step) || '', inputs.pull_request != '' && format(' · PR #{0}', inputs.pull_request) || '') ||
      github.event_name == 'issues' &&
      format('{0} · Task {1} · {2}', github.event.label.name == 'codex-ready-manual' && 'Manual handoff' || 'Auto implementation', github.event.issue.number, github.event.label.name) ||
      format('{0} · PR #{1} · {2}', github.event.label.name == 'codex-ready-manual' && 'Manual handoff' || 'Auto remediation', github.event.pull_request.number, github.event.pull_request.title) }}

on:
  issues:
    types: [labeled]
  pull_request_target:
    types: [labeled]
    branches: [@@BASE_BRANCH_YAML@@]
  workflow_dispatch:
    inputs:
      task:
        description: Canonical Issue number
        required: true
        type: string
      step:
        description: Legacy Step hint; native admission allocates its own Step
        required: false
        default: ''
        type: string
      route:
        description: Admitted execution route
        required: true
        type: choice
        options: [auto, manual]
      pull_request:
        description: Existing remediation PR number, if applicable
        required: false
        default: ''
        type: string

permissions:
  actions: read
  contents: read
  issues: read
  pull-requests: read

concurrency:
  group: @@CONTROL_GROUP_YAML@@
  cancel-in-progress: false
  queue: max

jobs:
  route:
    if: >-
      ${{ github.repository == '@@REPOSITORY@@' &&
          github.actor == '@@OWNER@@' && github.triggering_actor == '@@OWNER@@' &&
          github.ref == 'refs/heads/@@BASE_BRANCH@@' &&
          (github.event_name == 'workflow_dispatch' ||
           github.event.action == 'labeled' &&
           (github.event.label.name == 'codex-ready-auto' || github.event.label.name == 'codex-ready-manual')) &&
          (github.event_name != 'pull_request_target' ||
           github.event.pull_request.head.repo.full_name == github.repository) }}
    # Labels/if/identity checks are not the external runner scheduling boundary.
    # Keep runners inactive until the external runner restrictions are qualified.
    runs-on: @@GENERAL_RUNS_ON_YAML@@
    timeout-minutes: 120
    steps:
      - name: Run the accepted installed Relay
        shell: bash --noprofile --norc -euo pipefail {0}
        env:
          GITHUB_TOKEN: ${{ github.token }}
          RELAY_CONSUMER_CONFIG: /etc/@@NAMESPACE@@/consumer.json
          RELAY_REPOSITORY: @@REPOSITORY@@
          EXPECTED_WORKFLOW_CONTRACT: "@@WORKFLOW_CONTRACT@@"
          NODE_OPTIONS: ''
          NODE_PATH: ''
        run: |
          @@GENERAL_RUNNER_GUARD@@
          exec /usr/bin/node --input-type=module <<'NODE'
          import { readFile, realpath } from 'node:fs/promises';
          let boundary = 'installed routing source';
          try {
          const expectedContract = process.env.EXPECTED_WORKFLOW_CONTRACT;
          const release = await realpath('/opt/@@NAMESPACE@@/current');
          const identity = JSON.parse(await readFile(`${release}/reviewed-source/.relay-source.json`, 'utf8'));
          const head = identity.revision;
          const compatibility = JSON.parse(await readFile(`${release}/reviewed-source/deploy/workflows/contract.json`, 'utf8'));
          if (!/^[0-9a-f]{40}$/.test(head ?? '') || release !== `/opt/@@NAMESPACE@@/releases/${head}`) {
            throw new Error('INSTALLED_RELAY_IDENTITY_MISMATCH');
          }
          if (compatibility[expectedContract === 'relay-workflows-v4' ? 'parallelWorkflowContract' : 'workflowContract'] !== expectedContract ||
              !/^relay-workflows-v[1-9][0-9]*$/.test(expectedContract ?? '')) {
            throw new Error('RELAY_REPOSITORY_INTEGRATION_OUTDATED: publish the generated repository integration directory');
          }
          console.log(JSON.stringify({ installedRelayHead: head, workflowHead: process.env.GITHUB_SHA }));
          boundary = 'controller configuration and startup';
          const { main, reportRoutingResult } = await import(`${release}/bin/relay-routing.mjs`);
          process.exitCode = await reportRoutingResult(main);
          } catch (error) {
            const installed = error?.message === 'INSTALLED_RELAY_IDENTITY_MISMATCH';
            const projection = error?.message === 'RELAY_REPOSITORY_INTEGRATION_OUTDATED: publish the generated repository integration directory';
            const config = error?.code === 'CONSUMER_CONFIG_INVALID';
            const code = installed ? 'INSTALLED_RELAY_IDENTITY_MISMATCH' : projection ? 'RELAY_REPOSITORY_INTEGRATION_OUTDATED'
              : config ? 'CONSUMER_CONFIG_INVALID' : 'ROUTING_STARTUP_FAILED';
            const cause = installed ? 'The installed source path and revision did not agree.'
              : projection ? 'The installed and projected routing contracts did not match.'
              : config ? 'The installed consumer configuration failed validation.'
              : 'The underlying startup cause could not be established from the safe output.';
            const action = projection ? 'Verify and integrate the generated repository workflow projection for the accepted installation.'
              : 'Have the host operator verify the installed Relay source and selected consumer configuration.';
            const run = /^[1-9][0-9]{0,19}$/.test(process.env.GITHUB_RUN_ID ?? '') ? ` (run-${process.env.GITHUB_RUN_ID})` : '';
            console.error(`::error title=Relay routing startup::Relay failed at ${boundary}${run}. ${code}. ${cause} No worker started in this invocation. Next action: ${action}`);
            process.exitCode = 1;
          }
          NODE
