# Generated by Relay workflow projection; edit deploy/workflows/routing.yml.in.
# Workflow contract: @@WORKFLOW_CONTRACT@@; consumer review/merge remains required.
name: Relay routing
run-name: >-
  ${{ github.event_name == 'workflow_dispatch' &&
      format('{0} · Task {1}{2}{3}', inputs.route == 'manual' && 'Manual handoff' || inputs.pull_request != '' && 'Auto remediation' || 'Auto implementation', inputs.task, inputs.step != '' && format(' · Step {0}', inputs.step) || '', inputs.pull_request != '' && format(' · PR #{0}', inputs.pull_request) || '') ||
      github.event_name == 'issues' &&
      format('{0} · Task {1} · {2}', github.event.label.name == 'codex-ready-manual' && 'Manual handoff' || 'Auto implementation', github.event.issue.number,
      (contains(format('{0}{1}{0}', fromJSON('"\n"'), github.event.issue.body), format('{0}Authority model: github-native-v1{0}', fromJSON('"\n"'))) ||
      contains(format('{0}{1}{0}', fromJSON('"\n"'), github.event.issue.body), format('{0}Authority model: github-native-v1{1}{0}', fromJSON('"\n"'), fromJSON('"\r"')))) && github.event.label.name || join(github.event.issue.labels.*.name, ' · ')) ||
      format('{0} · PR #{1} · {2}', github.event.label.name == 'codex-ready-manual' && 'Manual handoff' || 'Auto remediation', github.event.pull_request.number, github.event.pull_request.title) }}

on:
  issues:
    types: [labeled]
  pull_request_target:
    types: [labeled]
    branches: [@@BASE_BRANCH_YAML@@]
  workflow_dispatch:
    inputs:
      task:
        description: Canonical Issue number
        required: true
        type: string
      step:
        description: Legacy Step hint; native admission allocates its own Step
        required: false
        default: ''
        type: string
      route:
        description: Admitted execution route
        required: true
        type: choice
        options: [auto, manual]
      pull_request:
        description: Existing remediation PR number, if applicable
        required: false
        default: ''
        type: string

permissions:
  actions: read
  contents: read
  issues: read
  pull-requests: read

concurrency:
  group: @@CONTROL_GROUP_YAML@@
  cancel-in-progress: false
  queue: max

jobs:
  route:
    if: >-
      ${{ github.repository == '@@REPOSITORY@@' &&
          github.actor == '@@OWNER@@' && github.triggering_actor == '@@OWNER@@' &&
          github.ref == 'refs/heads/@@BASE_BRANCH@@' &&
          (github.event_name == 'workflow_dispatch' ||
           github.event.action == 'labeled' &&
           (github.event.label.name == 'codex-ready-auto' || github.event.label.name == 'codex-ready-manual')) &&
          (github.event_name != 'pull_request_target' ||
           github.event.pull_request.head.repo.full_name == github.repository) }}
    # Labels/if/identity checks are not the external runner scheduling boundary.
    # Keep runners inactive until the external runner restrictions are qualified.
    runs-on: @@GENERAL_RUNS_ON_YAML@@
    timeout-minutes: 120
    steps:
      - name: Run the accepted installed Relay
        shell: bash --noprofile --norc -euo pipefail {0}
        env:
          GITHUB_TOKEN: ${{ github.token }}
          RELAY_CONSUMER_CONFIG: /etc/@@NAMESPACE@@/consumer.json
          EXPECTED_WORKFLOW_CONTRACT: "@@WORKFLOW_CONTRACT@@"
          NODE_OPTIONS: ''
          NODE_PATH: ''
        run: |
          @@GENERAL_RUNNER_GUARD@@
          exec /usr/bin/node --input-type=module <<'NODE'
          import { readFile, realpath } from 'node:fs/promises';
          const expectedContract = process.env.EXPECTED_WORKFLOW_CONTRACT;
          const release = await realpath('/opt/@@NAMESPACE@@/current');
          const identity = JSON.parse(await readFile(`${release}/reviewed-source/.relay-source.json`, 'utf8'));
          const head = identity.revision;
          const compatibility = JSON.parse(await readFile(`${release}/reviewed-source/deploy/workflows/contract.json`, 'utf8'));
          if (!/^[0-9a-f]{40}$/.test(head ?? '') || release !== `/opt/@@NAMESPACE@@/releases/${head}` ||
              compatibility[expectedContract === 'relay-workflows-v4' ? 'parallelWorkflowContract' : 'workflowContract'] !== expectedContract || !/^relay-workflows-v[1-9][0-9]*$/.test(expectedContract ?? '')) {
            throw new Error('INSTALLED_RELAY_IDENTITY_MISMATCH');
          }
          console.log(JSON.stringify({ installedRelayHead: head, workflowHead: process.env.GITHUB_SHA }));
          const { main, reportRoutingResult } = await import(`${release}/bin/relay-routing.mjs`);
          process.exitCode = await reportRoutingResult(main);
          NODE
