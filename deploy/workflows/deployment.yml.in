# Generated by Relay; publish only in the private deployment repository.
# Workflow contract: @@WORKFLOW_CONTRACT@@; configuration main is reviewed authority.
name: Owner Relay lifecycle
run-name: Owner Relay lifecycle · ${{ inputs.action }} · ${{ github.sha }}

on:
  workflow_dispatch:
    inputs:
      action:
        description: Apply accepted product and configuration main, stop, or resume
        type: choice
        required: true
        default: apply
        options: [apply, stop, resume]

permissions:
  contents: read
  actions: read

concurrency:
  group: @@PRODUCTION_GROUP_YAML@@
  cancel-in-progress: false

jobs:
  lifecycle:
    if: >-
      ${{ github.repository == '@@REPOSITORY@@' &&
          github.event_name == 'workflow_dispatch' &&
          github.actor == '@@OWNER@@' && github.triggering_actor == '@@OWNER@@' &&
          github.ref == 'refs/heads/main' }}
    runs-on: @@GENERAL_RUNS_ON_YAML@@
    timeout-minutes: 120
    steps:
      - name: Apply the frozen Git desired state through the protected helper
        shell: bash --noprofile --norc -euo pipefail {0}
        env:
          RELAY_LIFECYCLE_ACTION: ${{ inputs.action }}
          RELAY_GIT_TOKEN: ${{ github.token }}
          NODE_OPTIONS: ''
          NODE_PATH: ''
        run: |
          @@GENERAL_RUNNER_GUARD@@
          /usr/bin/node --input-type=module <<'NODE'
          import { readFile, realpath } from 'node:fs/promises';
          import { spawn } from 'node:child_process';
          const release = await realpath('/opt/@@NAMESPACE@@/current');
          const identity = JSON.parse(await readFile(`${release}/reviewed-source/.relay-source.json`, 'utf8'));
          const installed = identity.revision;
          const sha = process.env.GITHUB_SHA;
          const run = process.env.GITHUB_RUN_ID;
          const action = process.env.RELAY_LIFECYCLE_ACTION;
          if (!/^[0-9a-f]{40}$/.test(installed ?? '') ||
              release !== `/opt/@@NAMESPACE@@/releases/${installed}` ||
              !/^[0-9a-f]{40}$/.test(sha ?? '') || !/^[1-9][0-9]{0,19}$/.test(run ?? '') ||
              !['apply', 'stop', 'resume'].includes(action)) throw new Error('RELAY_GIT_DISPATCH_INVALID');
          const child = spawn('/usr/bin/sudo', ['-n', '/usr/local/sbin/@@NAMESPACE@@-owner-lifecycle',
            `git:${action}:${installed}:${sha}:${run}`],
            { env: { PATH: '/usr/bin:/bin', LANG: 'C.UTF-8' }, stdio: ['pipe', 'inherit', 'inherit'] });
          child.stdin.on('error', () => { process.exitCode = 1; });
          child.stdin.end(process.env.RELAY_GIT_TOKEN ?? '');
          delete process.env.RELAY_GIT_TOKEN;
          child.on('error', () => { process.exitCode = 1; });
          child.on('exit', code => { process.exitCode = code ?? 1; });
          NODE
