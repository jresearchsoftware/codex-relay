# Generated by Relay workflow projection; edit deploy/workflows/production.yml.in.
# Relay product revision: @@REVISION@@; consumer review/merge remains required.
name: Reconcile accepted Relay production
run-name: Reconcile accepted Relay production · ${{ github.sha }}

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: @@PRODUCTION_GROUP_YAML@@
  cancel-in-progress: false

jobs:
  reconcile:
    if: >-
      ${{ github.repository == '@@REPOSITORY@@' &&
          github.event_name == 'workflow_dispatch' &&
          github.actor == '@@OWNER@@' && github.triggering_actor == '@@OWNER@@' &&
          github.ref == 'refs/heads/@@BASE_BRANCH@@' }}
    # The organization group must separately allow only this workflow on main.
    # Never substitute label-only scheduling for that external boundary.
    runs-on: @@PRODUCTION_RUNS_ON_YAML@@
    timeout-minutes: 30
    steps:
      - name: Reconcile through the installed production boundary
        shell: bash --noprofile --norc -euo pipefail {0}
        env:
          EXPECTED_RELAY_HEAD: "@@REVISION@@"
          NODE_OPTIONS: ''
          NODE_PATH: ''
        run: |
          test "$RUNNER_NAME" = @@PRODUCTION_RUNNER_NAME@@
          test "$(/usr/bin/id -un)" = @@PRODUCTION_RUNNER_USER@@
          /usr/bin/node --input-type=module <<'NODE'
          import { readFile, realpath } from 'node:fs/promises';
          import { spawn } from 'node:child_process';
          const head = process.env.EXPECTED_RELAY_HEAD;
          const release = await realpath('/opt/@@NAMESPACE@@/current');
          const identity = JSON.parse(await readFile(`${release}/reviewed-source/.relay-source.json`, 'utf8'));
          if (!/^[0-9a-f]{40}$/.test(head ?? '') || release !== `/opt/@@NAMESPACE@@/releases/${head}` || identity.revision !== head) {
            throw new Error('INSTALLED_RELAY_IDENTITY_MISMATCH');
          }
          console.log(JSON.stringify({ installedRelayHead: head, workflowHead: process.env.GITHUB_SHA }));
          // The root-owned helper validates its protected config and current main
          // again under the production transition lock before any apply mutation.
          const consumerHead = process.env.GITHUB_SHA;
          if (!/^[0-9a-f]{40}$/.test(consumerHead ?? '')) throw new Error('CONSUMER_REVISION_INVALID');
          const child = spawn('/usr/bin/sudo', ['-n', '/opt/@@NAMESPACE@@/relay-production-local-apply', `${head}:${consumerHead}`],
            { stdio: ['ignore', 'inherit', 'inherit'] });
          child.on('error', () => { process.exitCode = 1; });
          child.on('exit', code => { process.exitCode = code ?? 1; });
          NODE
