# Generated by Relay workflow projection; edit deploy/workflows/production.yml.in.
# Workflow contract: @@WORKFLOW_CONTRACT@@; consumer review/merge remains required.
name: Owner Relay lifecycle
run-name: Owner Relay lifecycle · ${{ inputs.action }} · ${{ github.sha }}

on:
  workflow_dispatch:
    inputs:
      action:
        description: Apply accepted Relay main, gracefully stop, or resume
        required: true
        default: apply
        type: choice
        options:
          - apply
          - stop
          - resume

permissions:
  contents: read

concurrency:
  group: @@PRODUCTION_GROUP_YAML@@
  cancel-in-progress: false

jobs:
  lifecycle:
    if: >-
      ${{ github.repository == '@@REPOSITORY@@' &&
          github.event_name == 'workflow_dispatch' &&
          github.actor == '@@OWNER@@' && github.triggering_actor == '@@OWNER@@' &&
          github.ref == 'refs/heads/@@BASE_BRANCH@@' }}
    # Use the separate general runner: Reviewer transitions can restart the
    # dependent production runner. External scheduling policy remains required.
    runs-on: @@GENERAL_RUNS_ON_YAML@@
    timeout-minutes: 120
    steps:
      - name: Run the protected owner lifecycle
        shell: bash --noprofile --norc -euo pipefail {0}
        env:
          EXPECTED_WORKFLOW_CONTRACT: "@@WORKFLOW_CONTRACT@@"
          RELAY_LIFECYCLE_ACTION: ${{ inputs.action }}
          NODE_OPTIONS: ''
          NODE_PATH: ''
        run: |
          test "$RUNNER_NAME" = @@GENERAL_RUNNER_NAME@@
          test "$(/usr/bin/id -un)" = @@GENERAL_RUNNER_USER@@
          /usr/bin/node --input-type=module <<'NODE'
          import { readFile, realpath } from 'node:fs/promises';
          import { spawn } from 'node:child_process';
          const expectedContract = process.env.EXPECTED_WORKFLOW_CONTRACT;
          const release = await realpath('/opt/@@NAMESPACE@@/current');
          const identity = JSON.parse(await readFile(`${release}/reviewed-source/.relay-source.json`, 'utf8'));
          const head = identity.revision;
          const compatibility = JSON.parse(await readFile(`${release}/reviewed-source/deploy/workflows/contract.json`, 'utf8'));
          if (!/^[0-9a-f]{40}$/.test(head ?? '') || release !== `/opt/@@NAMESPACE@@/releases/${head}` ||
              compatibility.workflowContract !== expectedContract || !/^relay-workflows-v[1-9][0-9]*$/.test(expectedContract ?? '')) {
            throw new Error('INSTALLED_RELAY_IDENTITY_MISMATCH');
          }
          const consumerHead = process.env.GITHUB_SHA;
          if (!/^[0-9a-f]{40}$/.test(consumerHead ?? '')) throw new Error('CONSUMER_REVISION_INVALID');
          const action = process.env.RELAY_LIFECYCLE_ACTION;
          if (!['apply', 'stop', 'resume'].includes(action)) throw new Error('LIFECYCLE_ACTION_INVALID');
          console.log(JSON.stringify({ action, installedRelayHead: head, workflowHead: consumerHead }));
          // Only the root-owned installed coordinator resolves accepted main.
          // It freezes one exact target and verifies the reviewed consumer
          // projection before quiescing or changing the installation.
          const child = spawn('/usr/bin/sudo', ['-n', '/usr/local/sbin/@@NAMESPACE@@-owner-lifecycle', `${action}:${head}:${consumerHead}`],
            { stdio: ['ignore', 'inherit', 'inherit'] });
          child.on('error', () => { process.exitCode = 1; });
          child.on('exit', code => { process.exitCode = code ?? 1; });
          NODE
