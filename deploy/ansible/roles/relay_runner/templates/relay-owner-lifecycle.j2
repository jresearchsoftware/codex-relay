#!/bin/bash -p
set -euo pipefail
umask 077
export PATH=/usr/bin:/bin
unset BASH_ENV CDPATH ENV
fail() {
  case "$1" in
    ROOT_REQUIRED) action='Use the installed owner lifecycle command through its configured host authorization.' ;;
    ARGUMENT_CONTRACT_INVALID) action='Verify the action and exact revision arguments in the owner workflow.' ;;
    *) action='Have the host operator verify the protected installed source and its release identity.' ;;
  esac
  printf 'RELAY_OWNER_LIFECYCLE_BLOCKED=%s\nRelay owner lifecycle failed during startup. The lifecycle helper did not start. No Apply retry was attempted. Next action: %s\n' "$1" "$action" >&2
  exit 64
}
[[ "$#" -eq 1 ]] || fail ARGUMENT_CONTRACT_INVALID
[[ "$1" =~ ^(apply|stop|resume):[0-9a-f]{40}:[0-9a-f]{40}$ || "$1" =~ ^git:(apply|stop|resume|recover):[0-9a-f]{40}:[0-9a-f]{40}:[1-9][0-9]{0,19}$ ]] || fail ARGUMENT_CONTRACT_INVALID
[[ "$(/usr/bin/id -u)" == 0 ]] || fail ROOT_REQUIRED
# Never use runner-controlled Git, Python environment or executable paths.
PRODUCT_ROOT="$(/usr/bin/python3 -I - '{{ relay_install_root }}' "$1" 2>/dev/null <<'PY'
import os, re, stat, sys
from pathlib import Path
install = Path(sys.argv[1])
current = install / 'current'
info = current.lstat()
assert stat.S_ISLNK(info.st_mode) and info.st_uid == 0
release = Path(os.readlink(current))
assert re.fullmatch('[0-9a-f]{40}', release.name) and release == install / 'releases' / release.name
root = release / 'reviewed-source'
roots = [root]
recovery_root = '{{ relay_owner_lifecycle_recovery_root | default("") }}'
if recovery_root and sys.argv[2].startswith('git:recover:'):
    roots.append(Path(recovery_root))
for name in ['owner_lifecycle.py', 'lifecycle.py', 'lifecycle_process.py', 'timing.py', 'config.py', 'installed_config.py', 'deployment_lock.py', 'git_intent.py', 'repository_source.py']:
    for checked_root in roots:
        path = checked_root / 'deploy' / name
        # Retained source can predate optional observer/timing dependencies.
        # Present dependencies receive protection checks before Python imports.
        if (name in {'lifecycle_process.py', 'timing.py'} and not path.exists() and not path.is_symlink()
                and name[:-3].encode() not in (checked_root / 'deploy/owner_lifecycle.py').read_bytes()):
            continue
        for entry in [path, *path.parents]:
            info = entry.lstat()
            assert info.st_uid == 0 and not info.st_mode & 0o022
            assert (stat.S_ISREG(info.st_mode) and info.st_nlink == 1) if entry == path else stat.S_ISDIR(info.st_mode)
print(root)
PY
)" || fail INSTALLED_CODE_UNSAFE
cd /
{% if relay_owner_lifecycle_recovery_root | default('') %}
if [[ "$1" == git:recover:* ]]; then
  exec /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/env -i \
    HOME=/root PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 \
    /usr/bin/python3 '{{ relay_owner_lifecycle_recovery_root }}/deploy/owner_lifecycle.py' \
    "$1" --installed-source "$PRODUCT_ROOT"
fi
{% endif %}
exec /usr/bin/nsenter --mount=/proc/1/ns/mnt -- /usr/bin/env -i \
  HOME=/root PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 \
  /usr/bin/python3 "$PRODUCT_ROOT/deploy/owner_lifecycle.py" "$1"
