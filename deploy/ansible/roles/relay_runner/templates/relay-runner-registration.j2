#!/bin/bash
# managed-by: codex-relay
# Owner-mediated runner registration. Never log the token.
# Organization registration selects the isolated group configured by its owner;
# registration selects that group but does not establish or verify its ACL.
{% set registration_url = ('https://github.com/' ~ relay_github_repository.split('/')[0]) if relay_runner_registration_scope == 'organization' else ('https://github.com/' ~ relay_github_repository) %}
set -euo pipefail
umask 077

fail() { echo "RUNNER_REGISTRATION_FAIL code=$1" >&2; exit 1; }

[[ "$(id -u)" == 0 ]] || fail ROOT_REQUIRED
if (( $# > 0 )); then
  [[ $# == 2 && "$1" == --expect-binding && "${2:-}" == 'url={{ registration_url }} name={{ relay_runner_name }} label={{ relay_runner_labels | join(",") }} group={{ relay_runner_registration_group if relay_runner_registration_scope == "organization" else "-" }} work={{ relay_runner_work_root }}' ]] || fail REGISTRATION_CONFIGURATION_MISMATCH
fi
[[ "{{ relay_runner_repository }}" == "{{ relay_github_repository }}" ]] || fail REPOSITORY_CONTRACT
[[ -d "{{ relay_runner_root }}" && ! -L "{{ relay_runner_root }}" ]] || fail RUNNER_ROOT_INVALID
[[ "$(stat -c '%U:%G:%a:%F' '{{ relay_runner_root }}')" == '{{ relay_runner_user }}:{{ relay_runner_group }}:750:directory' ]] || fail RUNNER_ROOT_OWNERSHIP
[[ -x "{{ relay_runner_root }}/config.sh" && -x "{{ relay_runner_root }}/run.sh" ]] || fail RUNNER_PACKAGE_NOT_READY
[[ "$(runuser --preserve-environment --user '{{ relay_runner_user }}' -- env HOME='{{ relay_runner_home }}' '{{ relay_runner_root }}/bin/Runner.Listener' --version 2>/dev/null || true)" == *"2.336.0"* ]] || fail RUNNER_VERSION_MISMATCH

normalize_diagnostics() {
  find '{{ relay_runner_root }}/_diag' -maxdepth 1 -type f -exec chown '{{ relay_runner_user }}:{{ relay_runner_group }}' {} + -exec chmod 0640 {} + 2>/dev/null || true
}

validate_registration() {
  # Read the runner-owned marker with the runner's authority, never as root.
  # The credential file is inspected only for type/ownership/mode, not content.
  runuser --user '{{ relay_runner_user }}' -- /usr/bin/python3 - '{{ relay_runner_registration_marker }}' '{{ relay_runner_credentials_marker }}' '{{ registration_url }}' '{{ relay_runner_name }}' '{{ relay_runner_work_root }}' '{{ relay_runner_registration_group if relay_runner_registration_scope == "organization" else "" }}' <<'PY'
import json, os, stat, sys
try:
    marker, credentials, url, name, work, group = sys.argv[1:]
    for path in (marker, credentials):
        metadata = os.lstat(path)
        if not (stat.S_ISREG(metadata.st_mode) and metadata.st_uid == os.getuid()
                and metadata.st_gid == os.getgid() and stat.S_IMODE(metadata.st_mode) == 0o600):
            raise ValueError('metadata')
    descriptor = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, encoding='utf-8-sig') as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError('marker')
        state = json.loads(stream.read(65537))
    if not (state.get('gitHubUrl') == url and state.get('agentName') == name
            and state.get('workFolder') == work
            and type(state.get('agentId')) is int and state['agentId'] > 0
            and (not group or state.get('poolName') == group)):
        raise ValueError('identity')
except (OSError, ValueError, TypeError, AttributeError):
    sys.exit(1)
PY
}

if [[ -e '{{ relay_runner_registration_marker }}' || -L '{{ relay_runner_registration_marker }}' || -e '{{ relay_runner_credentials_marker }}' || -L '{{ relay_runner_credentials_marker }}' ]]; then
  validate_registration || fail REGISTRATION_STATE_AMBIGUOUS
  normalize_diagnostics
  echo 'RUNNER_REGISTRATION_PASS url={{ registration_url }} name={{ relay_runner_name }} label={{ relay_runner_labels | join(",") }} version=2.336.0 state=reused group={{ relay_runner_registration_group if relay_runner_registration_scope == "organization" else "-" }} work={{ relay_runner_work_root }}'
  exit 0
fi

if [[ -t 0 ]]; then
  printf 'Enter the temporary runner-registration value for %s (input hidden): ' '{{ registration_url }}' >&2
fi
IFS= read -r -s registration_value || registration_value=''
[[ ! -t 0 ]] || printf '\n' >&2
[[ -n "$registration_value" ]] || { echo 'fresh registration token required' >&2; fail FRESH_REGISTRATION_TOKEN_REQUIRED; }
trap 'unset registration_value ACTIONS_RUNNER_INPUT_TOKEN HOME' EXIT HUP INT TERM
export ACTIONS_RUNNER_INPUT_TOKEN="$registration_value"
export HOME='{{ relay_runner_home }}'

{% if relay_runner_registration_scope == 'organization' %}
registration_group_args=(--runnergroup '{{ relay_runner_registration_group }}')
{% else %}
registration_group_args=()
{% endif %}
if ! registration_output=$(runuser --preserve-environment --user '{{ relay_runner_user }}' -- /bin/bash -c 'cd "$1" && shift && exec ./config.sh "$@"' _ '{{ relay_runner_root }}' --unattended --url '{{ registration_url }}' --name '{{ relay_runner_name }}' --labels '{{ relay_runner_labels | join(',') }}' --work '{{ relay_runner_work_root }}' --disableupdate "${registration_group_args[@]}" 2>&1); then
  unset registration_value ACTIONS_RUNNER_INPUT_TOKEN
  normalize_diagnostics
  [[ ! -e '{{ relay_runner_registration_marker }}' && ! -L '{{ relay_runner_registration_marker }}' && ! -e '{{ relay_runner_credentials_marker }}' && ! -L '{{ relay_runner_credentials_marker }}' ]] || fail REGISTRATION_STATE_AMBIGUOUS
  # Recognized rejected credentials are retryable with fresh ephemeral input.
  # All other failures may have mutated GitHub and require diagnosis first.
  # Runner v2.336.0 ConfigurationManager.GetTenantCredential reports this
  # endpoint before its subsequent AddRunner/AddAgent registration mutation.
  if [[ "$registration_output" == *'Bad credentials'* || "$registration_output" == *'Http response code: Unauthorized'* || "$registration_output" == *'token has expired'* || "$registration_output" == *'Token has expired'* ||
        "$registration_output" == *"Http response code: NotFound from 'POST https://api.github.com/actions/runner-registration'"* ||
        "$registration_output" == *"Http response code: Forbidden from 'POST https://api.github.com/actions/runner-registration'"* ]]; then
    unset registration_output
    echo 'fresh registration token required' >&2
    fail FRESH_REGISTRATION_TOKEN_REQUIRED
  fi
  unset registration_output
  fail REGISTRATION_COMMAND_FAILED_INSPECT_BEFORE_RETRY
fi

unset registration_value ACTIONS_RUNNER_INPUT_TOKEN registration_output
normalize_diagnostics
validate_registration || fail REGISTRATION_STATE_AMBIGUOUS
echo 'RUNNER_REGISTRATION_PASS url={{ registration_url }} name={{ relay_runner_name }} label={{ relay_runner_labels | join(",") }} version=2.336.0 state=registered group={{ relay_runner_registration_group if relay_runner_registration_scope == "organization" else "-" }} work={{ relay_runner_work_root }}'
