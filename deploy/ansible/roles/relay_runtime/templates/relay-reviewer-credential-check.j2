#!/bin/sh
# managed-by: codex-relay
# Verify only names, ownership, mode, and readability. Never print secrets.
set -eu

case "${GITHUB_APP_ID:-}" in ''|*[!0-9]*) exit 20;; esac
case "${GITHUB_APP_INSTALLATION_ID:-}" in ''|*[!0-9]*) exit 21;; esac
test "${GITHUB_APP_PRIVATE_KEY_FILE:-}" = '{{ relay_reviewer_credential_key_file }}' || exit 22
test -z "${GITHUB_REVIEWER_TOKEN+x}" || exit 23
test -z "${GITHUB_WRITER_TOKEN+x}" || exit 24
test "$(stat -c '%U:%G:%a:%F' '{{ relay_reviewer_credential_env_file }}')" = 'root:{{ relay_reviewer_group }}:640:regular file' || exit 25
test "$(stat -c '%U:%G:%a:%F' '{{ relay_reviewer_credential_key_file }}')" = 'root:{{ relay_reviewer_group }}:640:regular file' || exit 26
test -r '{{ relay_reviewer_credential_key_file }}' || exit 27
