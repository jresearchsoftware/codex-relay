#!/bin/sh
# managed-by: codex-relay
# Interactive owner-local credential helper. Production also accepts the
# Codex access token through hidden terminal input; no secret is ever printed,
# passed in argv, or stored in shell history.
set -eu

test "$(id -u)" = 0 || { echo 'CREDENTIAL_PROVISIONING_REQUIRES_ROOT'; exit 40; }

prepare_pem_file() {
  path=$1
  owner=$2
  group=$3
  mode=$4
  if test -e "$path" || test -L "$path"; then
    test ! -L "$path" && test -f "$path" && \
      test "$(stat -c '%U:%G:%a' "$path")" = "$owner:$group:$mode" || {
      echo 'CREDENTIAL_PROVISIONING_REFUSES_UNSAFE_EXISTING_FILE'
      exit 41
    }
  else
    install -o "$owner" -g "$group" -m "$mode" /dev/null "$path"
  fi
}

prepare_pem_file '{{ relay_reviewer_credential_key_file }}' root '{{ relay_reviewer_group }}' 640
prepare_pem_file '{{ relay_writer_credential_key_file }}' root root 600

prepare_token_file() {
  path=$1
  owner=$2
  group=$3
  mode=$4
  if test -e "$path" || test -L "$path"; then
    test ! -L "$path" && test -f "$path" && \
      test "$(stat -c '%U:%G:%a' "$path")" = "$owner:$group:$mode" || {
      echo 'CREDENTIAL_PROVISIONING_REFUSES_UNSAFE_EXISTING_FILE'
      exit 46
    }
  else
    install -o "$owner" -g "$group" -m "$mode" /dev/null "$path"
  fi
}

validate_identity_file() {
  env_file=$1
  key_file=$2
  app_id=$3
  installation_id=$4
  key_var=GITHUB_APP_PRIVATE_KEY_FILE
  app_id_var=GITHUB_APP_ID
  installation_id_var=GITHUB_APP_INSTALLATION_ID
  test "$(stat -c '%F' "$env_file")" = 'regular file' || exit 42
  grep -Fx "$key_var=$key_file" "$env_file" >/dev/null || exit 43
  grep -Fx "$app_id_var=$app_id" "$env_file" >/dev/null || exit 44
  grep -Fx "$installation_id_var=$installation_id" "$env_file" >/dev/null || exit 45
}

validate_identity_file '{{ relay_reviewer_credential_env_file }}' '{{ relay_reviewer_credential_key_file }}' '{{ relay_reviewer_app_id }}' '{{ relay_reviewer_app_installation_id }}'
validate_identity_file '{{ relay_writer_credential_env_file }}' '{{ relay_writer_credential_key_file }}' '{{ relay_writer_app_id }}' '{{ relay_writer_app_installation_id }}'

if test '{{ relay_deployment_profile }}' = 'production'; then
  prepare_token_file '{{ relay_codex_access_token_file }}' '{{ relay_codex_user }}' '{{ relay_codex_group }}' 600
  echo 'Provide the two temporary private-key PEM files and the Codex access token in this trusted terminal. App identities are source-controlled. Do not start services.'
  "${EDITOR:-sensible-editor}" \
    '{{ relay_reviewer_credential_key_file }}' \
    '{{ relay_writer_credential_key_file }}'
  printf 'Enter the Codex access token (input hidden): ' >&2
  restore_terminal_echo() { stty echo </dev/tty 2>/dev/null || true; }
  trap restore_terminal_echo EXIT HUP INT TERM
  stty -echo </dev/tty
  if ! IFS= read -r codex_access_token </dev/tty; then
    restore_terminal_echo
    echo 'CREDENTIAL_PROVISIONING_CODEX_TOKEN_INPUT_FAILED'
    exit 49
  fi
  restore_terminal_echo
  trap - EXIT HUP INT TERM
  printf '\n' >&2
  test -n "$codex_access_token" || { echo 'CREDENTIAL_PROVISIONING_CODEX_TOKEN_EMPTY'; exit 50; }
  printf '%s\n' "$codex_access_token" > '{{ relay_codex_access_token_file }}'
  unset codex_access_token
else
  echo 'Provide only the two temporary private-key PEM files in this terminal. App identities are source-controlled. Do not start services.'
  "${EDITOR:-sensible-editor}" \
    '{{ relay_reviewer_credential_key_file }}' \
    '{{ relay_writer_credential_key_file }}'
fi

validate_pem_file() {
  key_file=$1
  test -s "$key_file" || exit 47
  grep -q '^-----BEGIN .*PRIVATE KEY-----$' "$key_file" || exit 48
  grep -q '^-----END .*PRIVATE KEY-----$' "$key_file" || exit 49
}

validate_pem_file '{{ relay_reviewer_credential_key_file }}'
validate_pem_file '{{ relay_writer_credential_key_file }}'

if test '{{ relay_deployment_profile }}' = 'production'; then
  test -s '{{ relay_codex_access_token_file }}' || exit 51
  test "$(stat -c '%U:%G:%a:%F' '{{ relay_codex_access_token_file }}')" = '{{ relay_codex_user }}:{{ relay_codex_group }}:600:regular file' || exit 52
fi

set -a
. '{{ relay_reviewer_credential_env_file }}'
set +a
runuser -u '{{ relay_reviewer_user }}' --preserve-environment '{{ relay_install_root }}/relay-reviewer-credential-check'

unset GITHUB_APP_PRIVATE_KEY_FILE GITHUB_APP_ID GITHUB_APP_INSTALLATION_ID
set -a
. '{{ relay_writer_credential_env_file }}'
set +a
'{{ relay_install_root }}/relay-writer-credential-check'

if test '{{ relay_deployment_profile }}' = 'production'; then
  echo 'CREDENTIAL_PROVISIONING_CODEX_TOKEN_READY'
fi
echo 'CREDENTIAL_PROVISIONING_READY'
