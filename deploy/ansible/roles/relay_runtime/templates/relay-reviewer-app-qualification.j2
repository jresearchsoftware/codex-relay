#!/bin/sh
# managed-by: codex-relay
# Reviewer-only read-only GitHub App qualification. Never print secrets.
set -eu
test "$(id -un)" = '{{ relay_reviewer_user }}' || { echo 'APP_QUALIFICATION_WRONG_BOUNDARY'; exit 50; }
set -a
. '{{ relay_reviewer_credential_env_file }}'
set +a
export RELAY_APP_ROLE=reviewer
export RELAY_EXPECTED_APP_SLUG='{{ relay_reviewer_app_slug }}'
export RELAY_EXPECTED_ACTOR='{{ relay_reviewer_expected_actor }}'
export RELAY_EXPECTED_WRITE_PERMISSION_NAMES='pull_requests,checks,issues'
# Installation also requires actions:read; the probe token remains metadata-only.
export RELAY_TOKEN_PERMISSIONS='metadata:read'
export RELAY_EXPECTED_KEY_MODE=0640
# Reuse the single-target probe with the same App/installation for every target.
for repository in {% for repository in relay_reviewer_repositories %}'{{ repository }}' {% endfor %}; do
  export RELAY_EXPECTED_REPOSITORY="$repository"
  /usr/bin/python3 '{{ relay_install_root }}/relay-app-qualification.py'
done
