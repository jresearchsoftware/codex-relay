#!/usr/bin/env bash
set -euo pipefail

reviewer_service='{{ relay_reviewer_service_name }}'
activation_marker='{{ relay_reviewer_activation_marker }}'
recovery_off_marker='{{ relay_reviewer_recovery_off_marker }}'
expected_listener='{{ relay_reviewer_bind_address }}:8787'
operation_state='{{ relay_production_operation_state_path }}'
operation_lock='{{ relay_production_operation_lock_path }}'

# This is a read-only runner start gate. It never starts Reviewer and never
# reads any credential material. A runner-enable transition or the controlled
# ordinary-apply Reviewer restart may pass only while the root operation helper
# holds the lock; a reboot/timer cannot reuse the record as authority.
state_rc=0
state_output="$($operation_state 2>&1)" || state_rc=$?
if [[ "$state_rc" -eq 90 ]]; then
  echo 'REVIEWER_READINESS_BLOCKED=UNSAFE_OPERATION_STATE' >&2
  exit 90
fi
if [[ "$state_rc" -ne 0 && "$state_rc" -ne 10 ]]; then
  echo 'REVIEWER_READINESS_BLOCKED=OPERATION_STATE_UNAVAILABLE' >&2
  exit 91
fi
if [[ "$state_rc" -eq 10 ]]; then
  [[ "$state_output" == *'phase=runner-enable'* || "$state_output" == *'phase=apply'* ]]
  /usr/bin/flock -n "$operation_lock" -c ':' >/dev/null 2>&1 && exit 32
fi

[[ ! -e "$recovery_off_marker" && ! -L "$recovery_off_marker" ]]
[[ -f "$activation_marker" && ! -L "$activation_marker" ]]
read -r marker_owner marker_mode < <(/usr/bin/stat -c '%U %a' "$activation_marker")
[[ "$marker_owner" == root && "$marker_mode" == 600 ]]
[[ "$(<"$activation_marker")" == authorized ]]
[[ "$(/bin/systemctl is-active "$reviewer_service" 2>/dev/null || true)" == "active" ]]
ss -H -ltn 2>/dev/null | grep -F -- "$expected_listener" >/dev/null
