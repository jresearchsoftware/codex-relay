# Secret-free common runtime contract. GitHub App identity values and private-key
# references are loaded only from the separately owner-provisioned service file.
RELAY_CONFIG_ROOT={{ relay_config_root }}
RELAY_STATE_ROOT={{ relay_state_root }}
RELAY_EVIDENCE_ROOT={{ relay_evidence_root }}
REVIEWER_RELAY_ENABLED={{ relay_reviewer_relay_enabled | bool | lower }}
REVIEWER_RELAY_DB={{ relay_state_root }}/reviewer/reviewer-relay.sqlite3
REVIEWER_CLIENT_CA_FILE={{ relay_tls_client_ca_file }}
REVIEWER_ADOPTION_SOCKET={{ relay_runtime_root }}/reviewer-proof/loaded.sock
REVIEWER_ADOPTION_UNIT_FILE={{ relay_reviewer_service_unit_path }}
REVIEWER_ADOPTION_ENV_FILES={{ relay_config_root }}/relay.env:{{ relay_reviewer_credential_env_file }}
