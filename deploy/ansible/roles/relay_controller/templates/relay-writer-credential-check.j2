#!/bin/sh
# managed-by: codex-relay
# Verify only names, ownership, mode, and readability. Never print secrets.
set -eu

case "${GITHUB_APP_ID:-}" in ''|*[!0-9]*) exit 30;; esac
case "${GITHUB_APP_INSTALLATION_ID:-}" in ''|*[!0-9]*) exit 31;; esac
test "${GITHUB_APP_PRIVATE_KEY_FILE:-}" = '{{ relay_writer_credential_key_file }}' || exit 32
test -z "${GITHUB_WRITER_TOKEN+x}" || exit 33
test -z "${GITHUB_REVIEWER_TOKEN+x}" || exit 34
test "$(stat -c '%U:%G:%a:%F' '{{ relay_writer_credential_env_file }}')" = 'root:root:600:regular file' || exit 35
test "$(stat -c '%U:%G:%a:%F' '{{ relay_writer_credential_key_file }}')" = 'root:root:600:regular file' || exit 36
test -r '{{ relay_writer_credential_key_file }}' || exit 37
