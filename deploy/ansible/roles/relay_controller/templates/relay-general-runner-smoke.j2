#!/bin/sh
# Explicit owner entrypoint. Installed only; never invoked by reconciliation.
set -eu
fail() { printf 'GENERAL_RUNNER_SMOKE_BLOCKED code=%s;child=unknown;cleanup=not-created\n' "$1" >&2; exit 64; }
test "$(id -u)" -eq 0 || fail OWNER_REQUIRED
test "$#" -eq 2 && test "$1" = --approved-head || fail ARGUMENTS_INVALID
head="$2"
/usr/bin/python3 - "$head" '{{ relay_install_root }}/current' '{{ relay_release_root }}' <<'PY' || fail INSTALLED_HEAD_UNAVAILABLE
import json
from pathlib import Path
import re
import sys
head, current, releases = sys.argv[1:]
try:
    assert re.fullmatch('[0-9a-f]{40}', head)
    release = Path(current).resolve(strict=True)
    assert release == Path(releases) / head
    manifest = json.loads((release / 'artifact-manifest.json').read_text())
    assert manifest['commit'] == head
except Exception:
    raise SystemExit(1)
PY
umask 0077
cd '{{ relay_install_root }}'
exec /usr/bin/env -i RELAY_CONSUMER_CONFIG='{{ relay_consumer_config_path }}' PATH=/usr/bin:/bin LANG=C LC_ALL=C \
  /usr/sbin/runuser -u '{{ relay_general_runner_user }}' -- /usr/bin/node \
  '{{ relay_release_root }}'/"$head"/reviewed-source/consumer-general-runner-smoke.mjs --approved-head "$head"
