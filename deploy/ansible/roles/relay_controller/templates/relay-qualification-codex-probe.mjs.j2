#!/usr/bin/node --experimental-default-type=module

import { chmod, mkdtemp, rm, writeFile } from "node:fs/promises";
import { execFile } from "node:child_process";
import { promisify } from "node:util";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

const exec = promisify(execFile);
const WORK_ROOT = "{{ relay_state_root }}/dispatch-work";
const REPOSITORY = {{ relay_github_repository | to_json }};
const PROBE_ISSUE = 999998;
const PROFILE = Object.freeze({ cliModelId: "gpt-5.6-luna", effort: "high" });
const BASE_ENV = Object.freeze({
  PATH: "/usr/bin:/bin",
  LANG: "C",
  LC_ALL: "C",
  TZ: "UTC",
  GIT_CONFIG_NOSYSTEM: "1",
  GIT_CONFIG_GLOBAL: "/dev/null",
  GIT_CONFIG_SYSTEM: "/dev/null",
  GIT_TERMINAL_PROMPT: "0",
  GCM_INTERACTIVE: "Never",
  GIT_OPTIONAL_LOCKS: "0",
  GIT_AUTHOR_NAME: "qualification-codex-probe",
  GIT_AUTHOR_EMAIL: "qualification-codex-probe@localhost",
  GIT_COMMITTER_NAME: "qualification-codex-probe",
  GIT_COMMITTER_EMAIL: "qualification-codex-probe@localhost"
});
const PROBE_BODY = [
  "This is a bounded non-routing runtime qualification probe.",
  "Do not access GitHub, use credentials, publish comments, create a PR, or edit production.",
  "Do not change the fixture. Return a bounded blocked result if the runtime contract cannot be completed safely."
].join("\n");

function safeEvidence(evidence, error) {
  return {
    status: error ? "blocked" : "success",
    errorCode: error?.code ?? null,
    childStarted: typeof evidence.codexChildStarted === "boolean" ? evidence.codexChildStarted : null,
    childState: typeof evidence.codexChildStarted === "boolean" ? (evidence.codexChildStarted ? "started" : "not_started") : "unknown",
    failureClass: typeof evidence.codexFailureClass === "string" ? evidence.codexFailureClass : null,
    executionId: evidence.diagnosticStore?.executionId ?? null,
    diagnosticStore: evidence.diagnosticStore?.status ?? "unavailable",
    storeCode: evidence.diagnosticStore?.storeCode ?? null,
    storeFailureCode: evidence.diagnosticStore?.code ?? null
  };
}

async function git(cwd, args) {
  return exec("/usr/bin/git", ["-C", cwd, ...args], { env: BASE_ENV });
}

async function main() {
  const { runCodex } = await import("{{ relay_install_root }}/current/reviewed-source/runtime/src/controller.mjs");
  const cwd = await mkdtemp(join(WORK_ROOT, "step19-codex-probe-"));
  await chmod(cwd, 0o2770);
  const evidence = {};
  let failure;
  try {
    await git(cwd, ["init", "--initial-branch=step19-probe"]);
    await writeFile(join(cwd, "PROBE_FIXTURE.txt"), "bounded-qualification-probe\n", { mode: 0o660 });
    await git(cwd, ["add", "PROBE_FIXTURE.txt"]);
    await git(cwd, ["commit", "-m", "qualification non-routing probe fixture"]);
    await git(cwd, ["remote", "add", "origin", `https://github.com/${REPOSITORY}.git`]);
    const { stdout: baseSha } = await git(cwd, ["rev-parse", "HEAD"]);
    await runCodex({
      profile: PROFILE,
      inputBytes: Buffer.from(PROBE_BODY),
      cwd,
      issueNumber: PROBE_ISSUE,
      issueUrl: `https://github.com/${REPOSITORY}/issues/${PROBE_ISSUE}`,
      baseSha: baseSha.trim(),
      branch: "step19-probe",
      closurePolicy: "keep-open",
      taskTitle: "Relay non-routing Codex qualification",
      env: { ...BASE_ENV, CODEX_RUNTIME_TIMEOUT_MS: "600000" },
      evidence
    });
  } catch (error) {
    failure = error;
  } finally {
    await rm(cwd, { recursive: true, force: true });
  }

  const result = safeEvidence(evidence, failure);
  process.stdout.write(`NON_ROUTING_CODEX_PROBE_RESULT=${JSON.stringify(result)}\n`);
  if (result.diagnosticStore === "unavailable" && failure) process.exitCode = 1;
  if (result.childStarted !== true) process.exitCode = 1;
}

function isMainModule() {
  try { return Boolean(process.argv[1]) && fileURLToPath(import.meta.url) === process.argv[1]; }
  catch { return false; }
}

if (isMainModule()) {
  process.stderr.write(`${JSON.stringify({ status: "blocked", code: "STAGE_A_RUNTIME_RETIRED", message: "The historical Stage A Codex probe is retired" })}\n`);
  process.exitCode = 67;
}
