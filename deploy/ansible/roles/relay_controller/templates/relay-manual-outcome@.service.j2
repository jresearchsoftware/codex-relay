[Unit]
Description=Relay bounded Writer manual Outcome publication

[Service]
User=root
Group=root
# Preserve the existing quiescence proof's /system.slice/<unit> cgroup binding.
Slice=system.slice
ExecStart={{ relay_install_root }}/relay-manual-outcome-writer
StandardInput=socket
StandardOutput=socket
StandardError=null
TimeoutStartSec=60
RuntimeMaxSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ relay_writer_claim_root }}
