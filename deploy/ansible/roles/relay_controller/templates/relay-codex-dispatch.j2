#!/bin/sh
set -eu
export RELAY_CONSUMER_CONFIG='{{ relay_consumer_config_path }}'
export RELAY_REPOSITORY='{{ relay_github_repository }}'
{% if relay_execution_slots is defined %}
export RELAY_EXECUTION_SLOT='{{ relay_execution_slot }}'
{% endif %}
exec /usr/bin/node '{{ relay_codex_dispatch_release_path }}' "$@"
