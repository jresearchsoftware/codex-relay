# Generated example. Review and replace only the Relay distribution URL/revision.
# VibeVM 1.0.7 needs both explicit Git source roots; transitive Git tables are ignored.
[project]
name = "relay-guidance-consumer"
version = "0.0.0"
spec_format = "mixed"

[requires.packages]
"org.jresearch.ai/codex-relay" = { version = "=3.1.1", git = "REPLACE_WITH_SELECTED_RELAY_DISTRIBUTION_GIT_URL", rev = "REPLACE_WITH_IMMUTABLE_RELAY_DISTRIBUTION_COMMIT", auth = "none" }
"org.jresearch.ai/development-governance" = { version = "=4.0.0", git = "https://github.com/jrs-vibevm/org.jresearch.ai.development-governance.git", rev = "f14da40725cd35fb3117ae84a506256505340787", auth = "none" }
